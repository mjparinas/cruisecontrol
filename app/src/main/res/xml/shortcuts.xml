<?xml version="1.0" encoding="utf-8"?>
<!-- Google Assistant App Actions: "Hey Google, start a task to add dark mode to aiauto on Cruise Control" opens
     MainActivity with the spoken request, which starts the task straight away. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.START_TASK"
        app:queryPatterns="@array/start_task_queries">
        <intent
            android:action="dev.aiauto.action.START_TASK"
            android:targetPackage="dev.aiauto"
            android:targetClass="dev.aiauto.MainActivity">
            <parameter
                android:name="request"
                android:key="request"
                android:mimeType="https://schema.org/Text" />
        </intent>
    </capability>
</shortcuts>
